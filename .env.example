# The workflows normally supply these as GitHub secrets.
RUNPOD_API_KEY=
RUNPOD_SSH_PRIVATE_KEY_FILE=

# Optional scheduling controls for on-prem/community capacity.
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_DATA_CENTER_IDS=

# Override the default registry namespace from matrix.json when developing.
BUILDER_IMAGE_PREFIX=madiatorlabs/sageattention-wheel-builder

# Operator reference values; Actions does not read this file automatically.
# Candidate values match workflow defaults: ordered, comma-separated exact
# scheduling IDs. Compilation hides the build GPU, so that list may span
# architectures. Every validation list stays within one compute capability.
RUNPOD_BUILD_BACKEND=GPU
RUNPOD_BUILD_GPU_ID="NVIDIA A100 80GB PCIe"
RUNPOD_BUILD_GPU_CANDIDATES="NVIDIA A100 80GB PCIe,NVIDIA A100-SXM4-80GB,NVIDIA H100 PCIe,NVIDIA H100 80GB HBM3,NVIDIA H100 NVL,NVIDIA H200,NVIDIA GeForce RTX 5090,NVIDIA RTX PRO 6000 Blackwell Server Edition"
RUNPOD_GPU_ID_SM80="NVIDIA A100 80GB PCIe"
RUNPOD_GPU_CANDIDATES_SM80="NVIDIA A100 80GB PCIe,NVIDIA A100-SXM4-80GB"
RUNPOD_GPU_ID_SM86="NVIDIA A40"
RUNPOD_GPU_CANDIDATES_SM86="NVIDIA A40,NVIDIA RTX A6000,NVIDIA GeForce RTX 3090"
RUNPOD_GPU_ID_SM89="NVIDIA GeForce RTX 4090"
RUNPOD_GPU_CANDIDATES_SM89="NVIDIA GeForce RTX 4090,NVIDIA RTX 6000 Ada Generation,NVIDIA L4"
RUNPOD_GPU_ID_SM90="NVIDIA H100 PCIe"
RUNPOD_GPU_CANDIDATES_SM90="NVIDIA H100 PCIe,NVIDIA H100 80GB HBM3,NVIDIA H100 NVL,NVIDIA H200"
RUNPOD_GPU_ID_SM120="NVIDIA GeForce RTX 5090"
RUNPOD_GPU_CANDIDATES_SM120="NVIDIA GeForce RTX 5090,NVIDIA RTX PRO 6000 Blackwell Server Edition,NVIDIA RTX PRO 6000 Blackwell Workstation Edition,NVIDIA RTX PRO 4500 Blackwell Server Edition,NVIDIA RTX PRO 4500 Blackwell"

# GPU-backed build envelope and lifetime controls.
RUNPOD_BUILD_MIN_VCPUS=4
RUNPOD_BUILD_RECOMMENDED_VCPUS=16
RUNPOD_BUILD_MIN_SYSTEM_RAM_GB=32
RUNPOD_BUILD_RECOMMENDED_SYSTEM_RAM_GB=64
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_HARD_TIMEOUT_SECONDS=14400
RUNPOD_TERMINATION_GRACE_SECONDS=900

# NVIDIA B200 (SM100) and NVIDIA B300 SXM6 AC (SM103) are not substitutes for
# SM120; SageAttention 2.2.0 has no SM10x path. Do not add MIG or RTX PRO 6000
# Max-Q profiles to these conservative defaults.
