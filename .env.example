# The workflows normally supply these as GitHub secrets.
RUNPOD_API_KEY=
RUNPOD_SSH_PRIVATE_KEY_FILE=

# Optional scheduling controls for on-prem/community capacity.
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_DATA_CENTER_IDS=

# Override the default registry namespace from matrix.json when developing.
BUILDER_IMAGE_PREFIX=madiatorlabs/sageattention-wheel-builder

# Operator reference values; Actions does not read this file automatically.
# GPU IDs match workflow defaults and are exact scheduling IDs, not fuzzy names.
# Compilation hides the attached build GPU and uses host-system CPU/RAM only.
RUNPOD_BUILD_BACKEND=GPU
RUNPOD_BUILD_GPU_ID="NVIDIA A100 80GB PCIe"
RUNPOD_GPU_ID_SM80="NVIDIA A100 80GB PCIe"
RUNPOD_GPU_ID_SM86="NVIDIA GeForce RTX 3090"
RUNPOD_GPU_ID_SM89="NVIDIA GeForce RTX 4090"
RUNPOD_GPU_ID_SM90="NVIDIA H100 PCIe"
RUNPOD_GPU_ID_SM120="NVIDIA GeForce RTX 5090"

# GPU-backed build envelope and lifetime controls.
RUNPOD_BUILD_MIN_VCPUS=4
RUNPOD_BUILD_RECOMMENDED_VCPUS=16
RUNPOD_BUILD_MIN_SYSTEM_RAM_GB=32
RUNPOD_BUILD_RECOMMENDED_SYSTEM_RAM_GB=64
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_HARD_TIMEOUT_SECONDS=14400
RUNPOD_TERMINATION_GRACE_SECONDS=900

# NVIDIA B200 (SM100) and NVIDIA B300 SXM6 AC (SM103) are not substitutes for
# the SM120 representative; SageAttention 2.2.0 has no SM10x dispatch path.
